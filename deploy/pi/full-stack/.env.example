# Generate the real .env with: python prepare.py init --host raspberrypi.local
COMPOSE_PROJECT_NAME=garsone-complete
TARGET_PLATFORM=linux/arm64
RELEASE_TAG=local
IMAGE_MODE=published
POSTGRES_IMAGE=postgres:16-alpine
# Defaults use the existing GitHub Actions publications. Prefer digest refs
# from prepare.py lock-images (images.lock.env) for a reviewed deployment.
CORE_IMAGE=mikedim95/garsone-core:pi
FRONT_IMAGE=mikedim95/garsone-front:pi
NODE_IMAGE=mikedim95/mqtt-printer:latest
FRONT_PORT=8080
CORE_PORT=8787
# New workflow images use same-origin /api; keep the raw API on Pi loopback.
CORE_BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=raspberrypi.local
PUBLIC_ORIGIN=http://raspberrypi.local:8080
POSTGRES_DB=garsone
POSTGRES_USER=garsone
POSTGRES_PASSWORD=
JWT_SECRET=
MQTT_USERNAME=garsone
MQTT_PASSWORD=
NODE_KEY=
NODE_PAIRING_SECRET=
NODE_HOSTNAME=garsone-pi
LOCAL_ADMIN_EMAIL=manager@garsone.local
LOCAL_ADMIN_PASSWORD=
LOCAL_WAITER_EMAIL=waiter@garsone.local
LOCAL_WAITER_PASSWORD=
LOCAL_COOK_EMAIL=cook@garsone.local
LOCAL_COOK_PASSWORD=
LOCAL_HYBRID_EMAIL=hybrid@garsone.local
LOCAL_HYBRID_PASSWORD=
LOCAL_STORE_NAME=Local venue
LOCAL_SEED_OFFLINE_MENU=false
LOCAL_MIGRATE_ARCHITECT=false
NODE_API_BASE=https://order-flow-api-3uuy.onrender.com
NODE_LAN_IP=
NODE_TAILSCALE_IP=
# Online broker for Architect control; venue orders use the separate local broker above.
ARCHITECT_MQTT_HOST=
ARCHITECT_MQTT_PORT=8883
ARCHITECT_MQTT_TLS=true
ARCHITECT_MQTT_USER=
ARCHITECT_MQTT_PASS=
STORE_SLUG=noor
MQTT_DISABLED=true
# Enable the bundled broker and local node together during full onboarding.
COMPOSE_PROFILES=
LOCAL_BOOTSTRAP_EMPTY=false
# Optional outbound cloud Architect updates; supply private data/qr-sync.json first.
QR_SYNC_ENABLED=false
# Enable only after pairing the real printer and setting its Linux device group.
BLUETOOTH_ENABLED=false
BLUETOOTH_GID=
LOG_LEVEL=info
# Only enable printer after setting its actual device and exact routing topic.
PRINTER_DEVICE=/dev/rfcomm0
PRINTER_DEVICE_SECOND=/dev/rfcomm1
PRINTER_TOPIC=noor/orders/preparing/printer_1
PRINTER_ARRIVAL_TOPIC=
TZ=Europe/Athens

# Private node-to-local-Core QR configuration synchronization
LOCAL_QR_SYNC_SECRET=
# Dedicated authenticated Architect relay between this Pi's node and Core.
LOCAL_CONTROL_SECRET=
